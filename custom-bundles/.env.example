SERVER_USER=xxx
SERVER_IP=xxx.xxx.xxx.xxx

# Tham khảo cấu hình runtime của Liferay (không phải biến build/deploy).
# Đặt biến này trong môi trường khởi động Liferay, ví dụ export trong
# $LIFERAY_HOME/tomcat/bin/setenv.sh, rồi restart Liferay trên từng node.
# File .env này và .env React ở thư mục gốc không tự truyền biến vào JVM đang chạy.
# true: duongcaotoc.com.vn và www. vẫn xem public, đồng thời được đăng nhập admin.
# false hoặc không khai báo: chỉ public như hiện tại. Subdomain khác không được mở admin.
VEC_DUONGCAOTOC_ADMIN_ENABLED=false
