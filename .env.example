REACT_APP_BASE_API_URL=https://your-domain.com
REACT_APP_FIREBASE_DB_URL=https://your-project-default-rtdb.region.firebasedatabase.app
REACT_APP_FIREBASE_DB_PATH=dashboard-layout

# Bật chế độ admin khi dev local (không deploy lên production)
REACT_APP_FORCE_ADMIN=false

# Fake API mode: true = Firebase Realtime DB, false = real Java/Liferay API
REACT_APP_USE_FIREBASE=true
