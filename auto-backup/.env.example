# =========================
# Local backup
# =========================

# Thư mục lưu các file backup tổng
BACKUP_DIR="/backup/liferay"

# Thư mục bundles Liferay cần backup và là nơi chạy:
#   blade server stop
#   blade server start
# Ví dụ: /opt/liferay/bundles
BUNDLE_DIR="/opt/liferay/bundles"

# Dung lượng tối thiểu cần còn trống trước khi backup, đơn vị GB
MIN_FREE_GB=40

# Chỉ giữ lại tối đa số bản backup này
# Khi tạo bản mới vượt quá giới hạn, script sẽ xoá bản cũ nhất
BACKUP_RETENTION_COUNT="3"

# Có stop Liferay trong lúc backup SQL + bundles không
# true  = stop Liferay trước khi dump SQL và nén bundles, backup nhất quán hơn
# false = không stop, ít downtime hơn nhưng dữ liệu có thể thay đổi trong lúc backup
STOP_SERVICE_DURING_BACKUP="false"


# =========================
# MySQL dump/restore
# =========================

# Thông tin MySQL/MariaDB của Liferay
MYSQL_HOST="10.2.18.30"
MYSQL_PORT="3306"
MYSQL_DATABASE="lportal"
MYSQL_USER="root"
MYSQL_PASSWORD="CHANGE_ME_MYSQL_PASSWORD"


# =========================
# SMTP mail alert
# =========================

MAIL_HOST="smtp.maileroo.com"
MAIL_PORT="587"

# Tài khoản SMTP
MAIL_USERNAME="vec.portal@expressway.com.vn"
MAIL_PASSWORD="CHANGE_ME_SMTP_PASSWORD"

# Email gửi đi
MAIL_FROM_ADDRESS="vec.portal@expressway.com.vn"

# Email nhận cảnh báo lỗi backup
MAIL_TO="vec.portal@expressway.com.vn"

# File log của script
LOG_FILE="/var/log/liferay-backup.log"


# =========================
# Restore SQL
# =========================

# Có restore SQL khi restore backup không
# false = chỉ restore bundles
# true  = restore cả SQL nếu file SQL hợp lệ
RESTORE_SQL_ENABLED="true"


# =========================
# Cron
# =========================

# Cron mặc định chạy lúc 00:30 mỗi ngày
CRON_SCHEDULE="30 0 * * *"

# File log dùng riêng cho cron
CRON_LOG_FILE="/var/log/liferay-backup-cron.log"
